# Copy to api/.env. The first one set wins, in this order:

# A model on the plant network (Ollama, vLLM, llama.cpp): plant data stays on site.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SCREENFORGE_MODEL=qwen2.5:14b-instruct

# OPENAI_API_KEY=
GROQ_API_KEY=
# XAI_API_KEY=

# Optional
# SCREENFORGE_MODEL=openai/gpt-oss-120b
# SCREENFORGE_REASONING_EFFORT=low
# SCREENFORGE_TAG_SOURCE=sim            # sim (built-in) or live (OPC UA / Modbus from each tag's source)
# SCREENFORGE_OPCUA_ALLOW=127.0.0.1:4840,localhost:4840
# SCREENFORGE_LLM_PER_MINUTE=12
# SCREENFORGE_CORS_ORIGINS=http://localhost:3000
