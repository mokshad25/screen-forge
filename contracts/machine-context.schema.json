{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://screenforge.dev/contracts/machine-context/v2",
  "title": "ScreenForge Machine Context",
  "description": "Everything ScreenForge knows about one machine. v2 adds engineering ranges, alarm conditions, alarm playbooks (related_tags), protocol addresses and aliases.",
  "type": "object",
  "required": [
    "asset_id",
    "context_version",
    "asset_hierarchy",
    "tags",
    "io",
    "alarms",
    "comms"
  ],
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "context_version": {
      "type": "string"
    },
    "asset_hierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "description": "Words operators use for this machine that are not in its tag names (e.g. 'belt'). Used for asset detection.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "access"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "description": "Identifier only: letters, digits, underscore. Names reach the model's prompt, so free text is not allowed here."
          },
          "type": {
            "type": "string",
            "enum": [
              "bool",
              "analog"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 16
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 120
          },
          "range": {
            "description": "Engineering range of an analog tag. Gauges are scaled to this, never to recent history.",
            "type": "object",
            "required": [
              "low",
              "high"
            ],
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              }
            }
          },
          "source": {
            "$ref": "#/definitions/source"
          }
        }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digital_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digital_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analog_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analog_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alarms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "desc",
          "priority",
          "tag",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "desc": {
            "type": "string",
            "maxLength": 80
          },
          "priority": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Warning"
            ]
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "condition": {
            "description": "The alarm is active while `<tag value> <op> <value>` holds.",
            "type": "object",
            "required": [
              "op",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  ">",
                  ">=",
                  "<",
                  "<=",
                  "==",
                  "!="
                ]
              },
              "value": {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "related_tags": {
            "description": "Alarm playbook: the signals an engineer wants on screen when this alarm fires.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          }
        }
      }
    },
    "comms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device",
          "protocol",
          "endpoint",
          "health_tag"
        ],
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "protocol": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "health_tag": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        }
      }
    }
  },
  "definitions": {
    "source": {
      "description": "Where a tag's live value is read from. Absent means simulated.",
      "type": "object",
      "required": [
        "protocol",
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "opcua",
            "modbus",
            "connection"
          ]
        },
        "device": {
          "type": "string",
          "description": "comms[].device this tag is read through"
        },
        "address": {
          "type": "string",
          "description": "opcua: NodeId string (ns=2;s=...). modbus: holding register number or 'coil:N'. connection: the comms device whose link state this tag reports."
        },
        "scale": {
          "type": "number",
          "description": "modbus only: engineering value = raw * scale"
        }
      }
    }
  }
}
