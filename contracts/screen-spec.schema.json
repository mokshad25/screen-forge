{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenForge Screen Specification",
  "type": "object",
  "required": ["screen_id", "title", "asset_id", "context_version", "components", "permissions"],
  "additionalProperties": false,
  "properties": {
    "screen_id": { "type": "string" },
    "title": { "type": "string" },
    "asset_id": { "type": "string" },
    "context_version": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    },
    "permissions": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["read_only"] }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["id", "type", "priority", "size_hint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["alarm_banner", "status_indicator", "gauge", "trend", "nav_tile", "comms_health"]
        },
        "bind_tag": { "type": "string" },
        "bind_alarms": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "bind_device": { "type": "string" },
        "bind_asset": { "type": "string" },
        "priority": { "type": "integer", "minimum": 1 },
        "size_hint": { "type": "string", "enum": ["compact", "medium", "wide"] },
        "min_panel": { "type": "string", "enum": ["small", "medium", "large"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "alarm_banner" } }, "required": ["type"] },
          "then": {
            "required": ["bind_alarms"],
            "not": { "anyOf": [{ "required": ["bind_tag"] }, { "required": ["bind_device"] }, { "required": ["bind_asset"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "comms_health" } }, "required": ["type"] },
          "then": {
            "required": ["bind_device"],
            "not": { "anyOf": [{ "required": ["bind_tag"] }, { "required": ["bind_alarms"] }, { "required": ["bind_asset"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "nav_tile" } }, "required": ["type"] },
          "then": {
            "required": ["bind_asset"],
            "not": { "anyOf": [{ "required": ["bind_tag"] }, { "required": ["bind_alarms"] }, { "required": ["bind_device"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["status_indicator", "gauge", "trend"] } }, "required": ["type"] },
          "then": {
            "required": ["bind_tag"],
            "not": { "anyOf": [{ "required": ["bind_alarms"] }, { "required": ["bind_device"] }, { "required": ["bind_asset"] }] }
          }
        }
      ]
    }
  }
}